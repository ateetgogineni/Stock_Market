# Copy to .env (project root) and fill in. Never commit .env.

# Enables the Claude research agents. Without it, agents are reported as "skipped"
# and the report is built from the deterministic engines only.
ANTHROPIC_API_KEY=

# Free option: Google Gemini API free tier. Get a key at https://aistudio.google.com/apikey
# (a Google One / Gemini app subscription is not needed and does not include API usage).
GEMINI_API_KEY=
# Which provider the agents use: auto (Claude if its key is set, else Gemini), anthropic or gemini.
SRP_AGENT_PROVIDER=auto
SRP_GEMINI_MODEL=gemini-3.6-flash
SRP_GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-3.1-flash-lite

# Model and effort for the research agents.
SRP_AGENT_MODEL=claude-opus-5-5
SRP_AGENT_EFFORT=medium
SRP_AGENTS_ENABLED=true

# Market-data adapter: yahoo_dev (unlicensed, delayed/EOD, development only) or fixture (synthetic, offline).
SRP_PROVIDER=yahoo_dev

# Storage. Defaults to SQLite under backend/data; point at PostgreSQL in later phases.
# SRP_DATABASE_URL=postgresql+psycopg://user:pass@localhost/research

# Where the Next.js dev server proxies /api/* (set in web/.env.local if the backend is not on 127.0.0.1:8000).
# BACKEND_URL=http://127.0.0.1:8000
